{
  "name": "@nuluno/access-community",
  "version": "0.1.0-alpha.2",
  "description": "Open core for scoped agent authorization, durable tasks, reconciliation and revocation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nuluno-access-community": "dist/server.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "Dockerfile",
    "compose.yaml",
    "THIRD_PARTY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "scripts/demo-public-read.mjs",
    "scripts/demo-write-recovery.mjs",
    "scripts/mcp-stdio-bridge.mjs",
    "scripts/public-agent-fixture.mjs",
    "LICENSE",
    "NOTICE",
    "scripts/accept-commercial-extension.mjs",
    "examples/public-status"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts src/service.ts src/core/client.ts src/core/types.ts src/extensions/registry.ts src/host-ports.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs --banner:js='#!/usr/bin/env node' && tsc -p tsconfig.build.json",
    "start": "node dist/server.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "demo:public": "node scripts/demo-public-read.mjs",
    "demo:recovery": "node scripts/demo-write-recovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/core/client.d.ts",
      "import": "./dist/core/client.mjs",
      "default": "./dist/core/client.mjs"
    },
    "./adapters": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.mjs",
      "default": "./dist/core/types.mjs"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.mjs",
      "default": "./dist/service.mjs"
    },
    "./extensions": {
      "types": "./dist/extensions/registry.d.ts",
      "import": "./dist/extensions/registry.mjs",
      "default": "./dist/extensions/registry.mjs"
    },
    "./host-ports": {
      "types": "./dist/host-ports.d.ts",
      "import": "./dist/host-ports.mjs",
      "default": "./dist/host-ports.mjs"
    }
  },
  "license": "Apache-2.0"
}
