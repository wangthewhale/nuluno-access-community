{
  "name": "@nuluno/access-community",
  "version": "0.1.0-alpha.3-hub.1",
  "description": "Apache community core with a portable owner-paired account hub (candidate)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nuluno-access-community": "dist/server.mjs",
    "nuluno-access-hub": "dist/account-hub/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "Dockerfile",
    ".dockerignore",
    "compose.yaml",
    "THIRD_PARTY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "scripts/demo-public-read.mjs",
    "scripts/demo-write-recovery.mjs",
    "scripts/mcp-stdio-bridge.mjs",
    "scripts/public-agent-fixture.mjs",
    "LICENSE",
    "NOTICE",
    "examples/public-status",
    "scripts/install-account-hub.mjs",
    "scripts/accept-portable-hub.mjs",
    "scripts/build.mjs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test": "tsx --test tests/*.test.ts && node --test tests/hub-*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "demo:public": "node scripts/demo-public-read.mjs",
    "demo:recovery": "node scripts/demo-write-recovery.mjs",
    "hub": "node dist/account-hub/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/core/client.d.ts",
      "import": "./dist/core/client.mjs",
      "default": "./dist/core/client.mjs"
    },
    "./adapters": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.mjs",
      "default": "./dist/core/types.mjs"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.mjs",
      "default": "./dist/service.mjs"
    },
    "./extensions": {
      "types": "./dist/extensions/registry.d.ts",
      "import": "./dist/extensions/registry.mjs",
      "default": "./dist/extensions/registry.mjs"
    },
    "./host-ports": {
      "types": "./dist/host-ports.d.ts",
      "import": "./dist/host-ports.mjs",
      "default": "./dist/host-ports.mjs"
    },
    "./account-hub": {
      "types": "./dist/account-hub/server.d.ts",
      "import": "./dist/account-hub/server.mjs",
      "default": "./dist/account-hub/server.mjs"
    },
    "./app": {
      "types": "./dist/server.d.ts",
      "import": "./dist/app.mjs",
      "default": "./dist/app.mjs"
    },
    "./installation-keys": {
      "types": "./dist/account-hub/keys/src/key-source.d.mts",
      "import": "./dist/account-hub/keys/src/key-source.mjs",
      "default": "./dist/account-hub/keys/src/key-source.mjs"
    }
  },
  "license": "Apache-2.0"
}
