# Access Community 0.1.0-alpha.1. This is metadata, not a working secret file.
# Generate independent secrets privately with:
#   node dist/server.mjs init .env
# Do not copy a real .env, owner key, vault key or agent key into Git or a chat.
PORT=8892
HOST=127.0.0.1
NULUNO_ACCESS_ORIGIN=http://localhost:8892
NULUNO_ACCESS_STATE=./state/access.sqlite
# Required: two different independently generated secrets (at least 32 chars).
NULUNO_ACCESS_ADMIN_KEY=
NULUNO_ACCESS_VAULT_KEY=

# Optional absolute path to operator-owned reviewed extension JSON.
# Empty/unset means built-in Mastodon only; no Gmail/signup/Threads implementation.
# Each installed entry pins id,module,version,entrySha256; see docs/extensions.md.
NULUNO_ACCESS_EXTENSIONS_CONFIG=

# Optional provider-execution hold; does not revoke keys or erase original tasks.
NULUNO_ACCESS_EGRESS_PAUSED=false
